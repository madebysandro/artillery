{
  "name": "artillery-monorepo",
  "packageManager": "^npm@10.8.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint  --continue",
    "lint-fix": "turbo run lint-fix  --continue",
    "format": "npx prettier -w ./packages/**/*.{js,ts,json}",
    "prepare": "npx simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^9.1.2",
    "@commitlint/config-conventional": "^7.6.0",
    "lint-staged": "^13.2.3",
    "prettier": "^2.8.8",
    "simple-git-hooks": "^2.8.1",
    "turbo": "2.0.11"
  },
  "overrides": {
    "axios": "1.20.0",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "cipher-base": "1.0.7",
    "elliptic": "6.6.1",
    "fast-xml-parser": "4.5.7",
    "form-data@2": "2.5.6",
    "form-data@3": "3.0.5",
    "form-data@4": "4.0.6",
    "glob@10": "10.5.0",
    "http-cache-semantics": "4.3.0",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "jsonpath-plus": "10.4.0",
    "jws@3": "3.2.3",
    "jws@4": "4.0.1",
    "lodash": "4.18.1",
    "minimatch@3": "3.1.5",
    "minimatch@4": "4.2.6",
    "minimatch@5": "5.1.9",
    "minimatch@9": "9.0.9",
    "nanoid@3": "3.3.20",
    "path-to-regexp@0.1": "0.1.13",
    "pbkdf2": "3.1.7",
    "picomatch@2": "2.3.2",
    "postcss@8": "8.5.31",
    "protobufjs": "7.6.6",
    "proxy-addr": "2.0.8",
    "sha.js": "2.4.12",
    "socket.io-parser": "4.2.7",
    "tar": "7.5.22",
    "undici": "6.29.1",
    "ws@5": "5.2.7",
    "ws@7": "7.5.13",
    "ws@8": "8.22.0"
  },
  "simple-git-hooks": {
    "commit-msg": "npx commitlint --edit $1",
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.json": [
      "prettier --write"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "useTabs": false,
    "trailingComma": "none",
    "overrides": [
      {
        "files": "*.(yaml|yml)",
        "options": {
          "singleQuote": false
        }
      }
    ]
  }
}
